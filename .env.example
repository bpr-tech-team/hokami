# Mailtrap Email API, Transactional Stream (server-only).
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=info@hokami.cz
FORMS_TO_EMAIL=info@hokami.cz

# Google reCAPTCHA v3 (use separate keys for development and production).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=hokami.cz,www.hokami.cz
RECAPTCHA_MIN_SCORE=0.5

# Keystatic Cloud Free: team/project from the Cloud project's settings (public ID).
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=
# Explicit local writer, honoured only by next dev. Never enabled in production.
NEXT_PUBLIC_KEYSTATIC_LOCAL_MODE=false

