# Mailtrap Email API, Transactional Stream (server-only).
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=info@hokami.cz
FORMS_TO_EMAIL=info@hokami.cz
# Required separate recipient; whistleblowing never falls back to FORMS_TO_EMAIL.
WHISTLEBLOWING_TO_EMAIL=vpavlu@hokami.cz

# Google reCAPTCHA v3 (use separate keys for development and production).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional override; empty uses the canonical hostname and its www alias.
RECAPTCHA_ALLOWED_HOSTNAMES=
RECAPTCHA_MIN_SCORE=0.5

# Keystatic Cloud Free: team/project from the Cloud project's settings (public ID).
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=
# Explicit local writer, honoured only by next dev. Never enabled in production.
NEXT_PUBLIC_KEYSTATIC_LOCAL_MODE=false

# Google measurement (public IDs, configure both in Vercel Production).
# Missing/empty/invalid IDs disable GTM. Hosts come from NEXT_PUBLIC_SITE_DOMAIN.
# NEXT_PUBLIC values are bundled at build time; rebuild after changing them.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Production domain, without a protocol or path.
NEXT_PUBLIC_SITE_DOMAIN=hokami.cz

