{
  "name": "hokami",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.10.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:check && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "prepare": "husky",
    "content:check": "node --import tsx scripts/check-jobs.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@markdoc/markdoc": "^0.5.11",
    "@number-flow/react": "^0.6.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0",
    "vanilla-cookieconsent": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
